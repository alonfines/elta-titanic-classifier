# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Kaggle credentials (never commit)
kaggle.json
.kaggle/

# Dataset — the real train.csv is fetched from Kaggle via fetch_data.py, never committed.
# data/sample_train.csv is a small committed sample (see README) and stays tracked.
data/*
!data/sample_train.csv

# Trained weights + everything else train.py regenerates (preprocessor, config, logs, val split)
models/*
!models/.gitkeep

